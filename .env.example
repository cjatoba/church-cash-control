# Connection string do Neon (Postgres serverless).
# Crie um projeto em https://console.neon.tech, copie a "Connection string"
# (use a variante pooled para a aplicação) e cole abaixo.
DATABASE_URL="postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/church_cash_control?sslmode=require"

# Segredo usado pelo Auth.js para assinar sessões (JWT). Gere um valor com:
#   npx auth secret
# ou: openssl rand -base64 33
AUTH_SECRET="replace-with-a-random-secret"
